{
  "name": "action-tracker-app",
  "productName": "Action Tracker",
  "version": "0.1.0",
  "description": "Menu-bar app for the action-tracker checklist",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.quinter.action-tracker",
    "productName": "Action Tracker",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "../site", "to": "site" }],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.productivity",
      "extendInfo": { "LSUIElement": true },
      "identity": null
    }
  }
}
